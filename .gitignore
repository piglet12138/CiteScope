# ============================================================
# OS / IDE
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ============================================================
# Claude Code (本地工具配置, 含历史命令缓存可能含敏感信息)
# ============================================================
.claude/

# ============================================================
# Python
# ============================================================
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg
build/
*.coverage
.coverage
htmlcov/

# ============================================================
# Node / Frontend
# ============================================================
node_modules/
dist/
.vite/
*.log
*.tsbuildinfo
vite.config.d.ts
vite.config.js

# ============================================================
# Env / Secrets (任何形式的本地配置都不入库)
# ============================================================
.env
.env.local
.env.*.local
*.env
!.env.example
!*.env.example

# ============================================================
# 后端运行时数据 (DB / 截图 / cookie / 任意私有 JSON)
# ============================================================
backend/data/
!backend/data/.gitkeep
!backend/data/cookies/
backend/data/cookies/*
!backend/data/cookies/README.md

# Runtime config (live secrets)
runtime_config.json
**/runtime_config.json

# 截图证据
screenshots/
**/screenshots/

# SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 备份文件
*.bak
*.bak.*

# ============================================================
# 大型 / 二进制资源 (避免仓库膨胀)
# ============================================================
*.mov
*.mp4
*.avi
*.mkv
*.zip
*.tar.gz
*.7z

# 商业文档 (含内部信息)
*.docx
*.doc
*.pdf
!docs/api-contract.md
# 例外: 允许 docs/_assets 下的图片用于文档展示
!docs/_assets/**

# ============================================================
# 参考仓库 (clone 体积过大)
# ============================================================
references/

# ============================================================
# 临时 / 调试
# ============================================================
tmp/
temp/
*.tmp
.scratch/
