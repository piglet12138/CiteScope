# ============================================================
# CiteScope backend configuration
# ============================================================
# Copy this file to .env and fill in real values.
# All keys can also be overridden at runtime via the Settings UI
# (writes to backend/data/runtime_config.json with priority over .env).
# ============================================================

# === General ===
GEO_LOG_LEVEL=INFO
GEO_DB_PATH=./data/geo.db
GEO_SCREENSHOT_DIR=./data/screenshots

# ============================================================
# AI Search — Citation Analysis (3 essentials)
# ============================================================

# ChatGPT — OpenAI Responses API + web search
# Get from https://platform.openai.com/api-keys
OPENAI_OFFICIAL_API_KEY=
OPENAI_API_KEY=                                   # fallback if OPENAI_OFFICIAL not set
OPENAI_MONITOR_MODEL=gpt-4o-mini-search-preview

# Perplexity Sonar (or via OpenRouter)
# Direct:     PERPLEXITY_API_BASE=https://api.perplexity.ai   + MODEL=sonar
# OpenRouter: PERPLEXITY_API_BASE=https://openrouter.ai/api/v1 + MODEL=perplexity/sonar-pro-search
PERPLEXITY_API_KEY=
PERPLEXITY_API_BASE=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar

# Google AI (Gemini) — grounding via google_search tool
# Get from https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ============================================================
# Optional: Chinese AI engines
# ============================================================

# Doubao via Volcengine Ark (Responses API + builtin web_search)
# Get from https://www.volcengine.com/product/ark — control panel → API Key 管理
ARK_API_KEY=
DOUBAO_MODEL=doubao-seed-1-6-250615
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# Kimi — Moonshot official API
# Get from https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=

# DeepSeek — official API has no web search yet (2026-05). Falls back to
# chat.deepseek.com refresh_token reverse path (best-effort). Leave empty
# to skip DeepSeek monitor entirely.
# Extract from F12 → Application → Local Storage → chat.deepseek.com → userToken
DEEPSEEK_REFRESH_TOKEN=
