---
import Analytics from "../../../components/Analytics.astro";
const title = '开源 CiteScope：跟 Topify $99/月做同样的事，多做了一刀';
const subtitle = 'ANV 真实案例驱动 + span attribution 差异化 + 一个 solo dev 在「商业化 vs 开源」之间的 Open Core 取舍';
const description = '为客户 ANV 做 GEO 监测时把市场上的 Topify / Profound / Peec.ai 看了一圈，发现所有商业工具都没做 citation 跟品牌提及的句子级归因（span attribution）。自己造了一个 MIT 开源平替 CiteScope：6 家 AI 引擎统一 schema、Gemini grounding redirect 自动解析、Run 对比矩阵 + 雷达图。本文是发布稿 —— 讲为什么造、跟商业工具的逐项对比、ANV 真实跑出来的 Top Domains 数据，以及作为 solo dev 为什么选开源不直接卖 SaaS。';
const url = 'https://sg.yaoyuheng2001.me/posts/open-source-citescope/';
const datePublished = '2026-05-24';
const dateModified = '2026-05-24';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["BlogPosting", "TechArticle"],
  "headline": title,
  "alternativeHeadline": subtitle,
  "description": description,
