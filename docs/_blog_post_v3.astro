};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "CiteScope 是什么？跟 Topify / Profound / Peec.ai 这些商业 GEO 监测工具有什么区别？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "CiteScope 是一个 MIT 开源、自部署的 GEO (Generative Engine Optimization) 监测平台。把你的探针问题打到 ChatGPT / Perplexity / Gemini / 豆包 / Kimi / DeepSeek 六家 AI 搜索引擎，记录回答和 citation。商业工具（Topify $99-199/月、Profound $499+/月、Peec.ai €80-120/月）做的事一样，差异有三点：(1) CiteScope 完全开源 MIT，你可以审 100 行的 services/ai_monitors/chatgpt.py 知道 citation 到底是怎么解析的；(2) 实现了 span attribution —— 告诉你某条 citation 是否真的支撑了提到你品牌的那句话，所有商业工具都没做；(3) 自部署，数据在你自己 SQLite 文件里，不上传任何 SaaS。"
      }
    },
    {
      "@type": "Question",
      "name": "什么是 span attribution？为什么所有商业工具都没做？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Span attribution 是「这条 citation 实际支撑了 AI 回答里哪段话」的归因。Topify 能告诉你「Reddit 被引用 78%」，但 CiteScope 多一句：「这 78% 里有 23% 精确地支撑了提到你品牌的句子，55% 支撑无关竞品提及或行业通用论述」。算法 90 行 Python（services/citation_analysis/span_attribution.py）—— 按句子切分 AI 回答（处理中英文混排标点），找品牌词位置和 citation 标记位置的区间交集。商业工具不做的两个原因：(1) 计算成本不低且营销卖点不直观，(2) 一旦做了会暴露大多数 citation 追踪其实多浅。"
      }
    },
    {
      "@type": "Question",
      "name": "我要跑 CiteScope 需要什么？预算多少？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "硬件：1 vCPU / 1 GB RAM 的 VM 够用（SQLite 单库 + 单进程 uvicorn）。一行 docker compose up -d 起服务。API key 至少 3 把：OpenAI Official（platform.openai.com/api-keys，跑 ChatGPT web search）、Perplexity Sonar 或 OpenRouter、Google AI Studio（aistudio.google.com/apikey）。可选：火山方舟 Ark 接豆包、Moonshot 接 Kimi。预算估算：100 prompt × 3 平台 × 每周 1 次的典型频率，API 月成本 5-15 美元。Topify 卖你同样的数据 99 美元一个月。"
      }
    },
    {
      "@type": "Question",
      "name": "豆包和 DeepSeek 怎么接入？它们都有官方 search API 吗？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "豆包走火山方舟 Ark Responses API + 内置 web_search 工具（2026 Q1 上线），单轮调用，返回结构化 url_citation annotations 含 url / title / start_index / end_index，跟 OpenAI Responses API 几乎对齐。CiteScope 的 doubao.py adapter 自动把 [citation:N] 标记按 end_index 倒序插回正文，span attribution 完全可用。DeepSeek 官方 API 截至 2026-05 还没有 web search 工具，CiteScope 用 chat.deepseek.com 的 refresh_token + WASM POW 逆向作为 best-effort 兜底，等 DeepSeek 推官方 search endpoint 后会切回 API。"
      }
    },
    {
      "@type": "Question",
      "name": "已经在生产用了吗？数据安全怎么保证？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "已经在跑 —— 一个 B2B 出口袜厂客户（化名 ANV）的英文 AI 搜索 GEO 监测用了三周。数据完全在客户自己的 1GB VPS 上，所有探针 prompt / AI 响应 / citation 都落在本地 SQLite，不上传任何第三方 SaaS。这是开源 + 自部署相比 Topify / Profound 的核心安全优势：客户的探针 prompt 本身就是商业策略（看哪些竞品），不该出现在第三方厂商数据库里。"
      }
    },
    {
      "@type": "Question",
      "name": "为什么选开源不直接做 SaaS 卖钱？",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "三个理由：(1) 我是 solo dev，同时在维护其他几个项目，没有 6-12 个月的全职 runway 跟 VC 加持的 Topify / Profound 正面对抗 GTM；(2) Open Core 路径已经被 PostHog / Plausible / Cal.com / Supabase / n8n 验证 —— OSS 6-12 个月积累 stars 和反馈后再叠 hosted SaaS，capital-efficient，且 GitHub repo 本身就是最便宜的 lead gen；(3) ANV 真实案例只有开源才能引用（SaaS 不能秀客户内部数据）。所以现在的剧本是：先开源 6 个月看牵引力，如果有 500 stars 以上和重复出现 hosted 需求，就启动 citescope.cloud 卖 19-49 美元/月（undercut Topify）。"
      }
    }
  ]
};
